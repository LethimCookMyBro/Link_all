# PhantomLink Environment Variables

# Discord Bot Token (for discord_bot.py)
PHANTOMLINK_BOT_TOKEN=

# Discord Webhook URL for logs & notifications
PHANTOMLINK_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# C2 Server Configuration
PHANTOMLINK_SERVER_IP=81.10.55.8
PHANTOMLINK_HOST=0.0.0.0
PHANTOMLINK_PORT=5000

# Optional managed TLS and enrollment listeners (disabled until both files exist)
PHANTOMLINK_MANAGED_PORT=5443
PHANTOMLINK_ENROLLMENT_PORT=5444
PHANTOMLINK_TLS_CERT=
PHANTOMLINK_TLS_KEY=
PHANTOMLINK_MANAGED_STORE=managed-store

# API & Security
PHANTOMLINK_API_KEY=PhantomLink-API-2026
PHANTOMLINK_PASSWORD=PhantomLink
