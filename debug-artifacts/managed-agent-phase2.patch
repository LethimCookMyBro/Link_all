+}
+$CaptureText = [Text.Encoding]::UTF8.GetString([IO.File]::ReadAllBytes($CapturePcap))
+$Leaks = @('PING','PONG',$AgentId) | Where-Object { $CaptureText.Contains($_) }
+if ($Leaks) { throw "plaintext managed content found: $($Leaks -join ',')" }
+'PLAINTEXT_SCAN=PASS'
