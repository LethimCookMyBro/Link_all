+
+def test_degraded_snapshot_retains_beta_selection_and_disables_actions(query, actions):
+    add_beta(query)
+    data = ManagedDashboardData(query, actions, now=lambda: NOW)
+    data.refresh()
+    data.select(BETA_ID)
