+        second = socket.create_connection(("127.0.0.1", system._managed_port), timeout=1)
+        try:
+            assert second.recv(1) == b""
+        except ConnectionError:
+            pass
+        assert len(system.managed._threads) == 1
+    finally:
+        first.close()
+        if second is not None:
+            second.close()
