+        connect_timeout=2,
+        io_poll_interval=0.25,
+        controller_ping_interval=1,
+        controller_pong_timeout=1,
+        agent_read_deadline=3,
+        retry_base=1,
+        retry_max=30,
+        retry_jitter=0,
+    )
