+        ("GET", "/v1/enroll", None, 405),
+        ("POST", "/wrong", "{}", 404),
+        ("POST", "/v1/enroll", "not-json", 400),
+        ("POST", "/v1/enroll", json.dumps({"token": "x", "extra": 1}), 400),
+    ],
+)
+def test_enrollment_https_rejects_unexpected_requests(
